{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/solc/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__path=/api"
    },
    {
      "source": "/v2/api",
      "destination": "/api/index?__path=/v2/api"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index?__path=/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index?__path=/health"
    },
    {
      "source": "/mcp",
      "destination": "/api/index?__path=/mcp"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index?__path=/llms.txt"
    },
    {
      "source": "/badge/:file",
      "destination": "/api/index?__path=/badge/:file"
    },
    {
      "source": "/((?!assets/|img/|fonts/|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
