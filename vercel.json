{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 300, "memory": 2048 }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index?__path=/api" },
    { "source": "/v2/api", "destination": "/api/index?__path=/v2/api" },
    { "source": "/v1/:path*", "destination": "/api/index?__path=/v1/:path*" },
    { "source": "/health", "destination": "/api/index?__path=/health" },
    { "source": "/((?!assets/|img/|fonts/|favicon).*)", "destination": "/index.html" }
  ]
}
