{
  "name": "bytematch",
  "version": "0.1.0",
  "private": true,
  "description": "Source verification for contracts on Portaldot V3",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live",
    "compile:contracts": "tsx scripts/compile-contracts.ts",
    "deploy:registry": "tsx scripts/deploy-registry.ts",
    "attest:all": "tsx scripts/attest-all.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "ethers": "^6.13.4",
    "hono": "^4.6.14",
    "solc": "0.8.28",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@ethereumjs/common": "^4.4.0",
    "@ethereumjs/util": "^9.1.0",
    "@ethereumjs/vm": "^8.1.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
